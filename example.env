# Server
# `transfer` is off by default and requires WORKCELL_MCP_TRANSPORT=http: its tools mint URLs for the
# `/files` route, which only the HTTP transport serves.
WORKCELL_MCP_TOOL_GROUPS=files,code_graph,web,shell,python_execution
WORKCELL_MCP_TRANSPORT=stdio
WORKCELL_MCP_HTTP_PORT=3001
WORKCELL_MCP_HTTP_BIND=loopback
# Enables startup probes; `sudo -n` may refresh cached credentials on non-root Unix. See SECURITY.md.
WORKCELL_MCP_EXPOSE_EXECUTION_ENVIRONMENT=true
# Dual-era is the default. Set true to reject all pre-2026 MCP initialization.
# WORKCELL_MCP_MODERN_ONLY=false

# Code execution runs in a separate `monty` worker process with no filesystem, network, or
# environment access. The container ships the worker; a source build installs it with
# `make code-worker`. Set this explicitly where PATH is not fully controlled, or when the binary is
# not beside workcell-mcp.
# WORKCELL_MCP_CODE_WORKER=/usr/local/bin/monty
# WORKCELL_MCP_CODE_WORKER_CACHE=/var/cache/workcell-mcp
# Snippets are type-checked before execution by default. Set false to execute unchecked.
# WORKCELL_MCP_CODE_TYPE_CHECK=true

# Shell is denied by default. Prefer an immutable policy; use yolo only inside a suitable boundary.
# WORKCELL_MCP_SHELL_POLICY=/etc/workcell/shell-policy.toml
# WORKCELL_MCP_YOLO=false
# Shell output is filtered for the model by a built-in rule corpus; the structured result stays
# unfiltered. Set false to return raw command output.
# WORKCELL_MCP_SHELL_OUTPUT_FILTER=true

# Broad traversal applies the repository's own .gitignore rules for the file and code-graph tools.
# A path named explicitly is never excluded. Set false to traverse the tree untouched.
# WORKCELL_MCP_GITIGNORE=true

# HTTP authentication. Prefer WORKCELL_MCP_HTTP_TOKEN_FILE in production.
# WORKCELL_MCP_HTTP_TOKEN_FILE=/run/secrets/workcell-mcp-token
# WORKCELL_MCP_HTTP_TOKEN=replace-with-at-least-32-random-bytes
# WORKCELL_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Optional authenticated-HTTP remote-host discovery and volatile operation control over `/mcp`.
# Configure all five values together. They are opaque identifiers; one process represents one
# principal and one configured root represents one project. Keep the workspace generation stable
# across process restarts and change it when that workspace is replaced or reset. The extension remains
# absent over stdio and unauthenticated HTTP. Its bounded generic preparation ledger is lost on restart.
# WORKCELL_MCP_REMOTE_SERVER_ID=server-a
# WORKCELL_MCP_REMOTE_WORKSPACE_ID=workspace-a
# WORKCELL_MCP_REMOTE_WORKSPACE_GENERATION=generation-a
# WORKCELL_MCP_REMOTE_ROOT_PROJECT_ID=project-a
# WORKCELL_MCP_REMOTE_PRINCIPAL_ID=principal-a
# Snapshots require all five remote identifiers, the files group, write authority, and an existing
# absolute private directory outside the workspace. On Unix the directory must be owned by the process
# identity with no group/other access (for example, install -d -m 0700 /var/lib/workcell/snapshots).
# Snapshot bytes and durable restore journals remain server-side in this directory.
# WORKCELL_MCP_SNAPSHOT_ROOT=/var/lib/workcell/snapshots

# Largest single file transfer over `/files`, in bytes. Requires the `transfer` tool group. This is
# separate from the 12 MiB JSON body bound on `POST /mcp`; transfer bodies are streamed, not buffered.
# WORKCELL_MCP_MAX_TRANSFER_BYTES=67108864

# Logging
WORKCELL_LOG_LEVEL=info
WORKCELL_LOG_FORMAT=pretty

# Web search defaults to credential-free Exa.
# Search queries leave the Workcell boundary. Set disabled to retain webfetch without websearch egress.
# WORKCELL_WEBSEARCH_BACKEND=exa-mcp
# WORKCELL_WEBSEARCH_BACKEND=disabled

# Source-icon lookup is opt-in for websearch and webfetch and may issue additional outbound requests.
# WORKCELL_WEB_ICONS=true

# Outbound proxy for every web tool request. The conventional variables are honored as-is, so a
# sandbox that already exports them needs nothing here. They are also forwarded verbatim to every
# shell command, credentials included. A proxied request is resolved by the proxy, which then owns
# address policy and rebinding defense; see SECURITY.md.
# HTTPS_PROXY=http://proxy.internal:8080
# HTTP_PROXY=http://proxy.internal:8080
# NO_PROXY=localhost,127.0.0.1,::1
# Workcell-specific overrides win over the ambient environment for Workcell's own web tools; they are
# not forwarded to shell commands. Only http and https proxies are supported, and an unusable value
# stops startup rather than dialling directly.
# WORKCELL_MCP_HTTP_PROXY=http://proxy.internal:8080
# WORKCELL_MCP_NO_PROXY=localhost,127.0.0.1,::1

# Credentialed direct Exa API alternative.
# WORKCELL_WEBSEARCH_BACKEND=exa
# EXA_API_KEY=

# WORKCELL_WEBSEARCH_BACKEND=brave
# BRAVE_API_KEY=

# WORKCELL_WEBSEARCH_BACKEND=kagi
# KAGI_API_KEY=

# WORKCELL_WEBSEARCH_BACKEND=serpapi
# SERPAPI_API_KEY=
# SERPAPI_ENGINE=google

# WORKCELL_WEBSEARCH_BACKEND=searxng
# SEARXNG_URL=https://search.example.com
# Configure at most one SearXNG credential mode:
# SEARXNG_API_KEY=
# SEARXNG_BEARER_TOKEN=
# SEARXNG_USER=
# SEARXNG_PASSWORD=
