// Generated by pstack.statechart from-chart from sync.mmd. Reader states are the chart's own states.

// The actions the reader takes. facts.settled needs them. Add cause() and detail() as the spec grows.
fn reader_actions() {
	[]
}

fn state(v) {
	`${v.connection} | ${v.syncBadge}`
}

fn step(action) {
	let labels = #{
		TheNetworkDrops: "the network drops",
		TheNetworkReturns: "the network returns",
		YouEditANote: "you edit a note",
		TheServerConfirms: "the server confirms",
	};
	labels[action] ?? action
}
