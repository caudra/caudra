// Generated by pstack.statechart from-chart from upload.mmd. Reader states are the chart's own states.

// The actions the reader takes. facts.settled needs them. Add cause() and detail() as the spec grows.
fn reader_actions() {
	[]
}

fn state(v) {
	`${v.main}`
}

fn step(action) {
	let labels = #{
		TheLastByteArrives: "the last byte arrives",
		TheCheckPasses: "the check passes",
		YouChooseAFile: "you choose a file",
		TheNetworkDrops: "the network drops",
		YouRetry: "you retry",
		YouCancel: "you cancel",
	};
	labels[action] ?? action
}
