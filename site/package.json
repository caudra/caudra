{
  "name": "caudra-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "check": "astro check",
    "test": "bun test tests/unit",
    "build": "astro build --force",
    "preview": "astro preview --ignore-lock",
    "test:output": "bun test ./tests/output/site.test.ts",
    "test:browser": "playwright test",
    "recording:check": "bun scripts/recording-check.ts",
    "recording:poster": "bun scripts/recording-poster.ts",
    "recording:demo": "bun scripts/recording-demo.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "asciinema-player": "3.17.0",
    "astro": "7.3.5",
    "mermaid": "12.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/mdast": "4.0.4",
    "cheerio": "1.2.0",
    "typescript": "6.0.3"
  }
}
