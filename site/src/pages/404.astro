---
import SiteHead from '../components/SiteHead.astro';
import '../styles/brand.css';
---
<!doctype html>
<html lang="en">
  <head><SiteHead title="Page not found | Caudra" description="This page does not exist. Return to Caudra or browse the documentation." noindex /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header><nav aria-label="Primary"><a class="brand" href="/"><img src="/caudra-mark.svg" width="40" height="40" alt="" />caudra</a><a href="/docs/">Docs</a></nav></header>
    <main id="main" tabindex="-1">
      <p class="eyebrow">404 / Route not found</p>
      <h1>Nothing at this address.</h1>
      <p>This page does not exist. Check the address or find your next step in the documentation.</p>
      <div class="actions"><a class="primary" href="/docs/">Browse docs <span aria-hidden="true">↗</span></a><a href="/">Return home <span aria-hidden="true">↗</span></a></div>
    </main>
  </body>
</html>
<style>
  :global(html:root) { color-scheme: dark; scrollbar-color: #686c7c var(--ink); }
  :global(body) { margin: 0; background: var(--ink); color: var(--paper); font-family: var(--sans); }
  :global(:focus-visible) { outline-color: var(--signal-bright); }
  header, main { width: min(72rem, calc(100% - 3rem)); margin-inline: auto; }
  header { border-bottom: 1px solid var(--border-dark); }
  nav { display: flex; align-items: center; justify-content: space-between; padding-block: 1.5rem; }
  a { color: var(--paper); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: .25em; }
  .brand { display: inline-flex; align-items: center; gap: .75rem; font-size: 1.6rem; font-weight: 600; letter-spacing: -.04em; }
  main { padding-block: clamp(5rem, 14vw, 12rem); }
  .eyebrow { font: .75rem var(--mono); text-transform: uppercase; letter-spacing: .1em; color: var(--signal-bright); }
  h1 { max-width: 12ch; font-size: clamp(3rem, 8vw, 6rem); font-weight: 500; line-height: 1.02; letter-spacing: -.055em; margin-block: 1.5rem; }
  main > p:not(.eyebrow) { max-width: 40rem; color: var(--muted-dark); font-size: 1.125rem; line-height: 1.65; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .actions a { display: flex; gap: 1.5rem; justify-content: space-between; border: 1px solid var(--border-dark); padding: 1rem 1.25rem; }
  .actions .primary { color: var(--ink); background: var(--signal-bright); border-color: var(--signal-bright); }
  .skip-link { position: absolute; top: .5rem; left: 1.5rem; padding: .75rem; background: var(--paper); color: var(--ink); transform: translateY(-200%); }
  .skip-link:focus { transform: none; }
  @media (forced-colors: active) { :global(html:root) { scrollbar-color: auto; } }
</style>
