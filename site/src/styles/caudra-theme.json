{
  "name": "caudra",
  "type": "dark",
  "colors": {
    "editor.background": "#1B1D24",
    "editor.foreground": "#F5F5F2"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#A5A7B0", "fontStyle": "" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#ACCEB5" }
    },
    {
      "scope": ["string.unquoted"],
      "settings": { "foreground": "#E1E2E8" }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character.escape"
      ],
      "settings": { "foreground": "#DBBD8C" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#C5C7D0", "fontStyle": "" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#A5A7B0" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.command",
        "meta.function-call entity.name",
        "support.function.builtin"
      ],
      "settings": { "foreground": "#8CA6FF", "fontStyle": "" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#A9C8D5" }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name",
        "variable.other.member",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#C5C7D0" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#E1E2E8" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#ACCEB5" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E5ADAD" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#A9C8D5" }
    }
  ]
}
