---
interface Props {
  text: string;
}

const MARKDOWN_LINK = /\[([^\]]+)\]\(([^)\s]+)\)/;

const segments = Astro.props.text.split('`');
---
{segments.map((segment, index) => index % 2 === 1
  ? <code>{segment}</code>
  : segment.split(MARKDOWN_LINK).map((piece, at, pieces) => at % 3 === 1 ? <a href={pieces[at + 1]}>{piece}</a> : at % 3 === 0 && piece))}
