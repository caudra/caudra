---
interface Props {
  label: string;
}

const { label } = Astro.props;
---
<div class="clip-tabs" data-clip-tabs>
  <div class="clip-tab-list" role="group" aria-label={label} hidden></div>
  <slot />
</div>

<script>
  for (const container of document.querySelectorAll<HTMLElement>('[data-clip-tabs]')) {
    const list = container.querySelector<HTMLElement>('.clip-tab-list');
    const figures = [...container.querySelectorAll<HTMLElement>(':scope > .recording')];
    if (!list || figures.length < 2) continue;
    const buttons = figures.map((figure) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = figure.dataset.label ?? '';
      button.setAttribute('aria-controls', figure.id);
      list.append(button);
      return button;
    });
    const select = (active: number) => {
      buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === active)));
      figures.forEach((figure, index) => { figure.hidden = index !== active; });
    };
    buttons.forEach((button, index) => button.addEventListener('click', () => select(index)));
    list.hidden = false;
    select(0);
  }
</script>
