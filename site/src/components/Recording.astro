---
import { recordings } from '../data/recordings';

interface Props {
  id: string;
  title: string;
  summary: string;
  label?: string;
}

const { id, title, summary, label = title } = Astro.props;
const recording = Object.hasOwn(recordings, id) ? recordings[id] : undefined;
const captionId = `recording-${id}-caption`;
---

<figure class="recording" id={`recording-${id}`} data-label={label} aria-labelledby={captionId}>
  {recording ? (
    <caudra-recording data-recording-id={id} data-recording={JSON.stringify(recording)}>
      <div class="recording-stage" style={`--recording-ratio: ${recording.poster.width} / ${recording.poster.height}`}>
        <img class="recording-poster" src={recording.poster.src} alt={recording.poster.alt} width={recording.poster.width} height={recording.poster.height} loading="lazy" decoding="async" />
        <div class="recording-viewport" hidden tabindex="0" role="region" aria-label={`${recording.title} terminal recording. Scroll horizontally to inspect the terminal.`}>
          <div class="recording-player" />
        </div>
      </div>
      <div class="recording-actions" hidden>
        <button type="button" data-action="play">Play recording</button>
        <button type="button" data-action="replay" disabled>Replay</button>
        <button type="button" data-action="fullscreen" disabled>Fullscreen</button>
        {recording.chapters.length > 0 && (
          <div class="recording-chapters" role="group" aria-label={`${recording.title} chapters`}>
            {recording.chapters.map((chapter) => <button type="button" data-time={chapter.time} disabled>{chapter.title}</button>)}
          </div>
        )}
      </div>
      <p class="recording-status" role="status" aria-live="polite" />
      <noscript><p>Enable JavaScript to play this recording. The still frame and summary remain available.</p></noscript>
    </caudra-recording>
  ) : <slot />}
  <figcaption id={captionId}>
    <span class="recording-label">{recording ? `${recording.maturity === 'experimental' ? 'Experimental · ' : ''}Terminal recording · ${recording.title}` : 'Illustration'}</span>
    <span class="recording-summary">{recording?.summary ?? summary}</span>
    {recording?.edits && <span class="recording-edits">Edits: {recording.edits}</span>}
    {!recording && <span class="sr-only">{title}</span>}
  </figcaption>
</figure>

<script>
  import '../scripts/recording';
</script>

<style>
  .recording { margin: 0; min-width: 0; }
  caudra-recording { display: block; }
  .recording-stage { position: relative; aspect-ratio: var(--recording-ratio); background: #000; color: #fff; }
  .recording-poster { display: block; width: 100%; height: 100%; object-fit: contain; }
  .recording-viewport { position: absolute; inset: 0; overflow: auto; background: #000; }
  .recording-player { min-width: 48rem; height: 100%; }
  .recording-actions, .recording-chapters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .recording-actions { padding: .75rem; background: #111; color: #fff; }
  .recording-actions button { padding: .55rem .75rem; border: 1px solid #737373; background: #1b1b1b; color: #fff; font: inherit; cursor: pointer; }
  .recording-actions button:disabled { opacity: .5; cursor: default; }
  .recording-actions button:focus-visible, .recording-viewport:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .recording :global([hidden]) { display: none !important; }
  .recording :global(.ap-term), .recording :global(.ap-timer) { --term-font-family: var(--mono, monospace); }
  .recording :global(.ap-player) { border-radius: 0; }
  .recording-stage:fullscreen { width: 100%; height: 100%; aspect-ratio: auto; }
  .recording-status:empty { display: none; }
  figcaption { display: grid; gap: .35rem; padding-block: 1rem; }
  .recording-label { font-family: var(--mono, monospace); font-size: .75rem; }
  .recording-summary { max-width: 72ch; }
  .recording-edits { font-size: .875rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (prefers-reduced-motion: reduce) {
    .recording :global(*) { animation: none !important; transition: none !important; }
  }
</style>
