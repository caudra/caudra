---
import Inline from './Inline.astro';
import type { CapabilityGroup } from '../data/home';

interface Props {
  groups: readonly CapabilityGroup[];
}

const { groups } = Astro.props;
---
<div class="capability-wall">
  {groups.map((group) => (
    <div class="capability-group">
      <h3>{group.name}</h3>
      <ul>
        {group.items.map((item) => (
          <li><a href={item.href}><span><Inline text={item.name} /></span>{item.experimental && <span class="tag">Experimental</span>}</a></li>
        ))}
      </ul>
    </div>
  ))}
</div>
