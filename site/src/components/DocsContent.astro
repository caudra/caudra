---
import DefaultMarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import { getCollection } from 'astro:content';
import { pagePath } from '../data/docs';
import navigation from '../data/docs-navigation.json';

const overview = Astro.locals.starlightRoute.entry.id === 'docs';
const bySlug = new Map((await getCollection('docs')).map((page) => [page.id.replace(/^docs\//, ''), page.data]));
---

<DefaultMarkdownContent><slot /></DefaultMarkdownContent>
{overview && <nav class="docs-directory" aria-label="Documentation topics">
  {navigation.groups.map((group) => <section>
    <h2>{group.label}</h2>
    <ul>{group.pages.map((slug) => {
      const page = bySlug.get(slug)!;
      return <li><a href={pagePath(slug)}><strong>{page.title}</strong><span>{page.description}</span></a></li>;
    })}</ul>
  </section>)}
</nav>}

<script>
  const figures = document.querySelectorAll<HTMLElement>('.diagram');
  if (figures.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'neutral', fontFamily: 'JetBrains Mono, monospace' });
    for (const [index, figure] of Array.from(figures).entries()) {
      const source = figure.querySelector('.diagram-source')?.textContent;
      const target = figure.querySelector('.diagram-render');
      if (!source || !target) continue;
      try {
        const { svg } = await mermaid.render(`caudra-diagram-${index}`, source);
        target.innerHTML = svg;
        figure.querySelector('details')?.removeAttribute('open');
      } catch {
        target.textContent = 'Diagram preview unavailable. Source is shown below.';
      }
    }
  }
</script>
