            "snapshotRevision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "scope": { "const": "server-process" },
            "os": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "family",
                "architecture",
                "pathStyle",
