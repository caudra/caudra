      {
        "name": "file_glob",
        "title": "Glob files",
        "description": "Fast file pattern matching tool for files under the file root.\n\n- Supports glob patterns like \"**/*.js\" or \"src/**/*.ts\".\n- Returns matching file paths with byte sizes and line counts for bounded text files.\n- Use this tool when you need to find files by name patterns.\n- The optional path parameter limits the search root. Omit it to search the file root.\n- An empty path is treated as \".\".\n- Broad searches skip .git, node_modules, and regenerable build output and tool caches such as target, dist, .venv, and __pycache__. Dependency sources such as vendor are not skipped. Pass one of the skipped directories as the path to search inside it.\n- Broad searches also apply the repository's own .gitignore rules. Global and $GIT_DIR/info/exclude rules are not read. A path you name explicitly is never skipped, so passing an ignored directory as the path searches it.\n- Results are truncated to a safe result limit. A truncated result says so on its last line and reports how many files matched in total.\n- When you are doing an open-ended search that may require multiple rounds of globbing and grepping, prefer a higher-level sidequest/task flow once available.\n- This first local OSS executor is not sandboxed; hosts can override permission policy before exposing it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "Glob pattern supporting *, **, ?, and brace alternatives."
            },
            "path": {
              "description": "Optional directory under the configured root.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pattern"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "cwd": {
              "type": "string"
            },
            "relativePath": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FileListing"
              }
            },
            "count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "format": "uint",
              "minimum": 0,
              "description": "Files matching the pattern. Counting continues past the returned window,\nso this exceeds `count` when results were withheld. Exact when\n`scanComplete` is true, otherwise a lower bound."
            },
            "scanComplete": {
              "type": "boolean",
              "description": "Whether every candidate the traversal produced was examined. False when\nthe traversal or the match work budget stopped the scan early."
