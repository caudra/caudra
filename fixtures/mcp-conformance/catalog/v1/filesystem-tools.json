              "format": "uint",
              "minimum": 0,
              "description": "Candidate files actually searched. An exact match total is not reported\nbecause producing one would require reading every remaining file."
            },
            "filesListed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0,
              "description": "Candidate files the traversal listed. A lower bound when `truncated`."
            },
            "truncated": {
              "type": "boolean"
            },
            "ignored": {
              "type": "integer",
              "format": "uint",
